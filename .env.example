# Sightline Studio calls Gemini through Vertex AI with Application Default Credentials.
# Run: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=hacka-2026-09-agentic-cinema1
GOOGLE_CLOUD_LOCATION=us-central1
CLOUD_RUN_REGION=us-central1

# Optional: Gemini Developer API path (leave empty when using Vertex AI)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# AI execution mode: auto | live | record | replay
SIGHTLINE_AI_MODE=auto
PORT=8787
